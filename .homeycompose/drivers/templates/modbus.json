{
  "platforms": [
    "local"
  ],
  "connectivity": [
    "lan"
  ],
  "images": {
    "small": "{{driverAssetsPath}}/images/small.png",
    "large": "{{driverAssetsPath}}/images/large.png",
    "xlarge": "{{driverAssetsPath}}/images/xlarge.png"
  },
  "pair": [
    {
      "id": "list_devices",
      "template": "list_devices",
      "options": {
        "singular": true
      },
      "navigation": {
        "next": "route"
      }
    },
    {
      "id": "route",
      "template": "loading"
    },
    {
      "id": "manual",
      "$template": "manual",
      "navigation": {
        "prev": "list_devices"
      }
    },
    {
      "id": "add_devices",
      "template": "add_devices"
    }
  ],
  "repair": [
    {
      "id": "list_devices",
      "template": "list_devices",
      "options": {
        "singular": true
      },
      "navigation": {
        "next": "route"
      }
    },
    {
      "id": "route",
      "template": "loading"
    },
    {
      "id": "repair_manual",
      "$template": "manual",
      "navigation": {
        "prev": "list_devices"
      }
    },
    {
      "id": "done",
      "template": "done"
    }
  ]
}
